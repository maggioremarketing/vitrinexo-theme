{
  "name": "vitrinexo-theme",
  "version": "1.0.0",
  "description": "Tema de Vitrinexo. Las pruebas del manual de marca viven en pruebas/.",
  "scripts": {
    "verificar": "node pruebas/verificar.mjs",
    "accesibilidad": "node pruebas/accesibilidad.mjs",
    "avance": "node pruebas/avance.mjs",
    "retratos": "node herramientas/retratos.mjs assets/img/marca",
    "clases-sin-uso": "node herramientas/clases-sin-uso.mjs",
    "banco": "bash banco/montar.sh",
    "banco:servir": "PHP_CLI_SERVER_WORKERS=8 php -d opcache.enable=0 -S 127.0.0.1:8910 -t banco/wp/sitio",
    "banco:sesion": "node banco/sesion.mjs",
    "miembros": "VX_SESION=banco/wp/sesion.json VX_SESION_NUEVA=banco/wp/sesion-onboarding.json VX_SESION_ADMIN=banco/wp/sesion-admin.json npm run accesibilidad -- http://127.0.0.1:8910/marca"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luismaggiore/vitrinexo-theme.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/luismaggiore/vitrinexo-theme/issues"
  },
  "homepage": "https://github.com/luismaggiore/vitrinexo-theme#readme",
  "devDependencies": {
    "playwright": "^1.63.0"
  },
  "private": true
}
